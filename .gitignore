# Installed packages and build output
node_modules/
dist/
dist-ssr/

# Logs (the API writes backend/api.log; training runs write their own)
logs/
*.log

# Editors and operating systems
.vscode/
.idea/
.DS_Store

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
ml/weatherai_ml.egg-info/

# Secrets and local databases: never commit these
.env
.env.local
backend/.env
backend/.secrets.local
backend/tests/test.db

# Training data can be downloaded again. Trained models are committed, apart from
# their bulky test predictions and the calibration cache.
ml/data/
test_predictions.npz
ml/artifacts/india/calibration/

# Browser tests: screenshots from a failed comparison, kept only to look at
e2e/screenshots-failed/

# Lighthouse reports and its working folder (a local build can include the personal desktop picture)
ci/lighthouse/reports/
ci/lighthouse/.lighthouseci/

# Personal desktop art: a picture of your own choosing and its ASCII version. Kept out of git
# so it is never committed or published (docs/share/make_wallpaper_ascii.py makes it).
local/
src/local/
