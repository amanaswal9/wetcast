# Copy to backend/.env and fill in. Never commit backend/.env.
# PostgreSQL connection (psycopg 3 driver).
WEATHERAI_DATABASE_URL=postgresql+psycopg://weatherai:CHANGE_ME@localhost:5432/weatherai
# Where trained model artifacts live (defaults to ../ml/artifacts).
# WEATHERAI_ARTIFACTS_DIR=../ml/artifacts
# Allowed browser origins for the API, as a JSON list.
# WEATHERAI_CORS_ORIGINS=["http://localhost:5173"]
WEATHERAI_LOG_LEVEL=INFO
# Live track record: issue and score forecasts every N hours (0 turns the job off).
# WEATHERAI_TRACK_RECORD_INTERVAL_HOURS=3
# Official alerts: read India's NDMA Sachet feed every N minutes (0 turns polling off).
# WEATHERAI_ALERTS_POLL_MINUTES=10
